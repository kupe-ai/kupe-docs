{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kupe",
  "description": "Voice agents API — Python SDK, TypeScript SDK, and MCP.",
  "colors": {
    "primary": "#4048ff",
    "light": "#7077fb",
    "dark": "#010799"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/"
  },
  "favicon": "/logo/mark.png",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Satoshi",
      "source": "/fonts/Satoshi-Bold.woff2",
      "format": "woff2",
      "weight": 700
    },
    "body": {
      "family": "Satoshi",
      "source": "/fonts/Satoshi-Regular.woff2",
      "format": "woff2",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Console",
        "href": "https://hub.kupe.in"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://hub.kupe.in"
    }
  },
  "footer": {
    "socials": {
      "website": "https://kupe.in"
    }
  },
  "api": {
    "openapi": "openapi.yaml",
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "params": {
      "expanded": "closed"
    },
    "url": "full",
    "examples": {
      "languages": ["python", "typescript", "curl"],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "auth",
              "playground"
            ]
          },
          {
            "group": "Realtime",
            "icon": "audio-lines",
            "pages": ["realtime"]
          },
          {
            "group": "Platform",
            "icon": "layers",
            "pages": [
              "guides/features",
              "guides/prompting",
              "guides/campaigns",
              "guides/inbound",
              "guides/phones",
              "guides/kyc",
              "guides/ucc",
              "guides/voices",
              "guides/tools",
              "guides/databases",
              "guides/logs",
              "guides/billing"
            ]
          },
          {
            "group": "MCP",
            "icon": "bot",
            "pages": ["kupe-mcp"]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "square-terminal",
        "openapi": "openapi.yaml"
      },
      {
        "tab": "SDKs",
        "icon": "code",
        "groups": [
          {
            "group": "Python",
            "icon": "braces",
            "pages": [
              "sdk/python/index",
              "sdk/python/realtime"
            ]
          },
          {
            "group": "TypeScript",
            "icon": "file-code",
            "pages": [
              "sdk/typescript/index",
              "sdk/typescript/realtime"
            ]
          }
        ]
      },
      {
        "tab": "Migrate",
        "icon": "unplug",
        "groups": [
          {
            "group": "Start here",
            "icon": "compass",
            "pages": [
              "migrate/index",
              "migrate/hosts-auth"
            ]
          },
          {
            "group": "How to rewrite calls",
            "icon": "git-compare",
            "pages": [
              "migrate/agents",
              "migrate/realtime",
              "migrate/phones",
              "migrate/inbound",
              "migrate/campaigns",
              "migrate/tools",
              "migrate/knowledge",
              "migrate/logs",
              "migrate/billing",
              "migrate/orgs"
            ]
          },
          {
            "group": "MCP",
            "icon": "bot",
            "pages": ["migrate/mcp"]
          },
          {
            "group": "Complete Kupe App catalog",
            "icon": "table",
            "pages": [
              "migrate/paths-agents",
              "migrate/paths-voice",
              "migrate/paths-phones",
              "migrate/paths-campaigns",
              "migrate/paths-tools",
              "migrate/paths-knowledge",
              "migrate/paths-logs",
              "migrate/paths-billing",
              "migrate/paths-auth",
              "migrate/paths-no-equivalent"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Console",
          "href": "https://hub.kupe.in",
          "icon": "layout-dashboard"
        }
      ]
    }
  }
}
